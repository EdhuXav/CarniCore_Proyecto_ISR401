# ---------------------------------------------------------------------------
# .env.example -- CarniCore backend
#
# POR QUE EXISTE ESTE ARCHIVO
#   docker-compose.yml declara `env_file: ./backend/.env`. Ese archivo no
#   estaba en el repositorio y no habia ninguna plantilla, de modo que
#   `docker compose up -d` --el procedimiento documentado en el README-- FALLA
#   en un clon limpio con el error "env file not found".
#
# USO
#   cp backend/.env.example backend/.env
#   # edite backend/.env y cambie AL MENOS JWT_SECRET y las contrasenas
#   docker compose up -d
#
# .env esta excluido por .gitignore. NUNCA lo versione.
# ---------------------------------------------------------------------------

# --- Servidor --------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Origenes permitidos por CORS, separados por coma.
# En produccion NO use "*": permitiria que cualquier sitio llame a la API con
# las credenciales del usuario.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Base de datos ---------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=carnicore
DB_USER=carnicore_user
DB_PASSWORD=CAMBIE_ESTA_CONTRASENA

# --- Autenticacion ---------------------------------------------------------
# OBLIGATORIO. La version anterior de middlewares/auth.js tenia el valor de
# reserva "carnicore_dev_secret" embebido en el codigo fuente publico:
# cualquiera que leyera el repositorio podia firmar un token valido con rol de
# propietaria. Ahora el arranque falla si esta variable no esta definida.
#
# Genere uno propio:
#   openssl rand -hex 32
JWT_SECRET=GENERE_UNO_PROPIO_CON_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# --- Semilla de demostracion ----------------------------------------------
# Credenciales del usuario administrador que crea `npm run seed`.
# Son de demostracion: no las reutilice en ningun entorno real y no las
# publique en el README.
SEED_ADMIN_EMAIL=admin@carnicore.local
SEED_ADMIN_PASSWORD=CAMBIE_ESTA_CONTRASENA

# --- pgAdmin (perfil opcional "tools") -------------------------------------
PGADMIN_EMAIL=admin@carnicore.local
PGADMIN_PASSWORD=CAMBIE_ESTA_CONTRASENA
